{
  "name": "flood-community",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --max-http-header-size=65536 node_modules/next/dist/bin/next dev --port 3002",
    "prebuild": "node -e \"if(process.env.VERCEL){try{require('fs').rmSync('.next',{recursive:true,force:true});}catch{}}\"",
    "build": "next build --webpack",
    "start": "next start --port 3002",
    "lint": "eslint",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:run:headed": "cypress run --headed",
    "cy:run:auth": "cypress run --spec 'cypress/e2e/community/login.cy.ts,cypress/e2e/community/register.cy.ts,cypress/e2e/community/verify-email.cy.ts,cypress/e2e/community/forgot-password.cy.ts,cypress/e2e/community/reset-password.cy.ts,cypress/e2e/community/auth-gate.cy.ts'",
    "cy:run:feed": "cypress run --spec 'cypress/e2e/feed/**/*.cy.ts'",
    "cy:run:blog": "cypress run --spec 'cypress/e2e/blog/**/*.cy.ts'",
    "cy:run:sensors": "cypress run --spec 'cypress/e2e/sensors/**/*.cy.ts'",
    "cy:run:settings": "cypress run --spec 'cypress/e2e/settings/**/*.cy.ts'",
    "cy:run:community": "cypress run --spec 'cypress/e2e/community/**/*.cy.ts'",
    "cy:run:navigation": "cypress run --spec 'cypress/e2e/navigation/**/*.cy.ts'",
    "test:e2e": "start-server-and-test dev http://localhost:3002 cy:run",
    "test:e2e:open": "start-server-and-test dev http://localhost:3002 cy:open"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@react-google-maps/api": "^2.20.8",
    "@types/google.maps": "^3.64.0",
    "ioredis": "^5.10.1",
    "next": "16.2.1",
    "next-auth": "^5.0.0-beta.29",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-hot-toast": "^2.6.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "cypress": "^13.17.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "pg": "^8.20.0",
    "start-server-and-test": "^2.1.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
